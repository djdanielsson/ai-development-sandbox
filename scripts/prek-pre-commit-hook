#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

has_repo_config() {
  local path

  # Check the root directly so ignored/local-only configs are honored too.
  if [[ -f prek.toml || -f .pre-commit-config.yaml || -f .pre-commit-config.yml ]]; then
    return 0
  fi

  # Also honor nested project configs in monorepos. `prek run` will discover
  # those in workspace mode when no --config override is passed.
  while IFS= read -r -d '' path; do
    case "${path##*/}" in
      prek.toml|.pre-commit-config.yaml|.pre-commit-config.yml) return 0 ;;
    esac
  done < <(git ls-files --cached --others --exclude-standard -z)

  return 1
}

if has_repo_config; then
  exec prek run "$@"
fi

echo "No prek config found; using the sandbox default hooks."
exec prek run --config /usr/local/share/prek/default-config.yaml "$@"
